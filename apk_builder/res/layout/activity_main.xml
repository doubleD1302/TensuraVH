<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="Slime Icon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/slime_accent"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- System Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_status_title"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Shizuku Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shizuku_label"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_shizuku_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shizuku_checking"
                android:textColor="@color/text_body"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btn_req_shizuku"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/btn_req_shizuku"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@drawable/btn_primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#233554"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Game Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_label"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_game_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_checking"
                android:textColor="@color/text_body"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/package_name_text"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#233554"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Patch Version Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patch_label"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_patch_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/patch_version"
                android:textColor="@color/status_green"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_actions_title"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 1. Install Button -->
            <Button
                android:id="@+id/btn_install_patch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_install_patch"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_primary" />

            <!-- 2. Launch Game Button -->
            <Button
                android:id="@+id/btn_launch"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_launch_game"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_game"
                android:layout_marginTop="10dp" />

            <!-- 3. Check Update Button -->
            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_check_update"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/btn_update"
                android:layout_marginTop="10dp" />

            <!-- 4. Restore Button -->
            <Button
                android:id="@+id/btn_restore"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_restore_original"
                android:textColor="#FCA5A5"
                android:textSize="13sp"
                android:background="@drawable/btn_danger"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_log_title"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@color/log_bg"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="#A0AEC0"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:text="@string/log_ready" />
            </ScrollView>
        </LinearLayout>

        <!-- Footer / Repository Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Dự án Việt hóa Tensura • github.com/doubleD1302/TensuraVH"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>
</ScrollView>
